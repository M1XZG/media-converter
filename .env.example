# Media Converter configuration — copy to .env and adjust as needed.
# All values are optional; the defaults shown here are used when unset.

# Host to bind to. Use 127.0.0.1 to restrict access to the local machine only,
# or 0.0.0.0 to allow access from other machines on your network.
FLASK_HOST=0.0.0.0

# Port to listen on.
FLASK_PORT=5000

# Maximum upload size in bytes. 0 means unlimited (no cap).
# Example: 2147483648 for a 2 GB limit. Setting a cap is recommended if the
# app is reachable by anyone other than you.
MAX_CONTENT_LENGTH=0

# Hours before files in uploads/ and converted/ are auto-deleted.
CLEANUP_HOURS=24

# Minutes before completed files in downloads/ are deleted. Set to 0 to keep
# them indefinitely.
DOWNLOADS_CLEANUP_MINUTES=30

# INFO records download starts, completions, and detailed failures. DEBUG also
# records every output line emitted by yt-dlp and spotdl.
LOG_LEVEL=INFO

# Recent yt-dlp/spotdl lines included when a download fails (10-1000).
DOWNLOAD_LOG_TAIL_LINES=100
